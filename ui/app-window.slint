import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Action, MutedText, SingleLine, ResourceRow, HostToggle, HostRow, ProjectSkillRow, FormField, CandidateRow, ImportRow, ApplyHostRow, KeyValueRow, CountRow, IssueRow, MarkdownCell, MarkdownTableRow, MarkdownLink, MarkdownBlock } from "components.slint";
import { Editor } from "editor.slint";
import { HostSettings } from "settings.slint";
import { OverviewPage } from "overview.slint";
import { ResourcePage } from "resources.slint";
export { Theme }
export { ResourceRow, HostToggle, HostRow, ProjectSkillRow, FormField, CandidateRow, ImportRow, ApplyHostRow, KeyValueRow, CountRow, IssueRow, MarkdownCell, MarkdownTableRow, MarkdownLink, MarkdownBlock }

export component AppWindow inherits Window {
    title: "Chu Agent Manager · Rust + Slint";
    out property <image> application-icon: @image-url("../assets/app-icon.png");
    icon: root.application-icon;
    init => { Palette.color-scheme = ColorScheme.light; }
    preferred-width: 1360px; preferred-height: 860px;
    min-width: 1080px; min-height: 680px;
    background: Theme.background;
    default-font-size: 14px;
    in-out property <int> page: 0;
    in property <string> page-title: "总览";
    in property <string> page-description: "一个工作台，管理你的 Agent 资源。";
    in property <bool> busy: false;
    in property <bool> closing: false;
    in property <string> notice;
    in property <bool> notice-error;
    in property <bool> notice-warning;
    in property <string> task-label;
    in property <bool> task-can-cancel;
    in property <int> task-phase;
    in-out property <string> query;
    in property <[ResourceRow]> rows;
    in property <[HostRow]> hosts;
    in property <[HostRow]> visible-hosts;
    in property <[HostToggle]> deployments;
    in property <[ProjectSkillRow]> project-skills;
    in property <[string]> counts;
    in property <[CountRow]> count-rows;
    in property <[IssueRow]> issues;
    in property <string> settings-host-id;
    in property <string> selected-id;
    in property <string> selected-name;
    in property <string> selected-description;
    in property <string> selected-meta;
    in property <string> selected-content;
    in property <string> selected-models;
    in property <bool> selected-managed;
    in property <bool> selected-tracked;
    in property <string> action-one;
    in property <string> action-two;
    in property <string> action-three;
    in property <string> root-path;
    in-out property <length> list-scroll-y;
    in-out property <length> detail-scroll-y;
    in property <int> detail-load-state;
    in property <string> detail-error;
    in property <[MarkdownBlock]> markdown-blocks;
    in-out property <bool> markdown-source: false;
    in-out property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-description;
    in property <string> dialog-error;
    in property <bool> dialog-installer;
    in property <bool> dialog-importer;
    in property <bool> dialog-confirmation;
    in property <bool> dialog-short;
    in property <bool> dialog-busy;
    in property <bool> dialog-can-submit: true;
    in property <bool> dialog-can-cancel: true;
    in property <int> dialog-load-state;
    in property <bool> dialog-discard-open;
    in property <bool> dialog-mcp;
    in property <int> import-count;
    in property <bool> has-apply-targets;
    in-out property <[ImportRow]> import-rows;
    in-out property <[ApplyHostRow]> apply-hosts;
    in-out property <string> import-query;
    in-out property <int> import-host-filter;
    in property <[string]> import-host-names;
    in property <string> import-conflict;
    in property <string> import-compatibility;
    in-out property <[FormField]> fields;
    in-out property <[CandidateRow]> candidates;
    in-out property <int> mcp-type;
    in-out property <string> mcp-command;
    in-out property <string> mcp-endpoint;
    in-out property <[string]> mcp-args;
    in-out property <int> mcp-args-action;
    in property <int> mcp-args-stored-count;
    in-out property <[KeyValueRow]> mcp-env;
    in-out property <[KeyValueRow]> mcp-headers;
    in-out property <int> mcp-secret-action;
    in property <bool> mcp-secret-stored;
    in-out property <string> mcp-secret;
    in-out property <string> mcp-advanced;
    in-out property <bool> mcp-show-advanced;
    property <bool> interactive: !root.dialog-open && !root.closing;
    property <bool> writable: !root.busy && !root.dialog-open && !root.closing;
    property <string> focus-owner;
    property <int> return-focus-request;
    changed dialog-open => { if !root.dialog-open { root.return-focus-request += 1; } }
    callback navigate(int);
    callback navigate-target(int, string, string);
    callback search(string);
    callback select-row(string);
    callback select-relative(int);
    callback select-index(int);
    callback action(string);
    callback toggle(string, bool);
    callback project-toggle(string, string, bool);
    callback project-reset(string, string);
    callback save-host(string, string, string, string);
    callback host-visible(string, bool);
    callback restore-host(string);
    callback dismiss-notice();
    callback submit-dialog();
    callback close-dialog();
    callback preview-skills();
    callback import-selection-changed();
    callback import-filter-changed(string, int);
    callback retry-dialog();
    callback discard-dialog();
    callback continue-dialog();
    callback dialog-changed();
    callback field-changed(string);
    callback retry-detail();
    callback cancel-task();
    callback copy-text(string);
    callback copy-code(string);
    callback copy-uri(string);
    callback mcp-type-changed(int);
    callback mcp-arg-add();
    callback mcp-arg-remove(int);
    callback mcp-entry-add(string);
    callback mcp-entry-remove(string, int);
    callback mcp-entry-changed(string, int);
    public function copy-to-clipboard(value: string) {
        copy-buffer.text = value;
        copy-buffer.select-all();
        copy-buffer.copy();
        copy-buffer.text = "";
    }
    copy-buffer := TextInput {
        x: 0px; y: 0px; width: 0px; height: 0px;
        enabled: false; read-only: true; accessible-role: none;
    }
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 204px; background: Theme.card;
            Rectangle { x: parent.width - 2px; width: 2px; background: Theme.border; }
            VerticalLayout {
                padding: 20px; spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 42px; height: 42px; border-radius: 8px; border-width: 2px; border-color: Theme.border; background: Theme.primary;
                        Text { text: "C"; font-size: 27px; font-weight: 800; color: Theme.foreground; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Chu"; font-size: 30px; font-weight: 800; color: Theme.foreground; vertical-alignment: center; }
                }
                MutedText { text: "AGENT WORKSPACE"; font-size: 10px; }
                Rectangle { height: 14px; }
                for label[index] in ["总览", "项目管理", "Skills", "MCP 服务", "Providers", "自定义 Agent", "提示词", "References", "设置"]: Action {
                    text: label; primary: root.page == index; horizontal-stretch: 1;
                    min-height: 40px; enabled: root.interactive;
                    clicked => { root.focus-owner = "nav"; root.navigate(index); }
                }
                Rectangle { vertical-stretch: 1; }
                MutedText { text: "RUST + SLINT\n原生桌面 · 本地优先"; font-size: 11px; }
            }
        }
        VerticalLayout {
            padding: 24px; spacing: 14px;
            HorizontalLayout {
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 4px;
                    Text { text: root.page-title; font-size: 30px; font-weight: 800; color: Theme.foreground; wrap: no-wrap; overflow: elide; }
                    SingleLine { text: root.page-description; font-size: 13px; }
                }
                Action { text: root.busy ? "处理中…" : "刷新"; enabled: root.writable; clicked => { root.action("refresh"); } }
            }
            if root.notice != "": Rectangle {
                vertical-stretch: 0; min-height: 42px; max-height: 84px;
                background: root.notice-error ? Theme.error-surface : root.notice-warning ? Theme.muted : Theme.success-surface;
                border-width: 1px; border-color: root.notice-error ? Theme.destructive : root.notice-warning ? Theme.border : Theme.success; border-radius: 6px;
                HorizontalLayout {
                    padding: 8px; spacing: 10px;
                    Text { text: root.notice; color: root.notice-error ? Theme.destructive : Theme.foreground; wrap: word-wrap; max-height: 60px; overflow: elide; font-size: 13px; horizontal-stretch: 1; }
                    Action { text: "×"; accessible-name: "关闭通知"; compact: true; enabled: !root.dialog-open; clicked => { root.dismiss-notice(); } }
                }
            }
            if root.busy && root.task-label != "": HorizontalLayout {
                spacing: 10px;
                SingleLine { text: root.task-label + (root.task-phase == 2 ? " · 正在写入，请稍候" : ""); horizontal-stretch: 1; }
                if root.task-can-cancel && root.task-phase != 2: Action { text: "取消任务"; enabled: !root.dialog-open; clicked => { root.cancel-task(); } }
            }
            if root.page == 0: OverviewPage {
                counts: root.count-rows; legacy-counts: root.counts; issues: root.issues;
                hosts: root.visible-hosts; root-path: root.root-path; interactive: root.interactive; writable: root.writable;
                navigate(page) => { root.navigate(page); }
                navigate-target(page, id, host) => { root.navigate-target(page, id, host); }
                install => { root.focus-owner = "overview-install"; root.navigate(2); root.action("add"); }
                copy(value) => { root.copy-text(value); }
            }
            if root.page == 8: HostSettings {
                hosts: root.hosts; busy: !root.writable; interactive: root.interactive; target-host: root.settings-host-id;
                focus-request: root.focus-owner == "host" ? root.return-focus-request : 0;
                save(id, config, skills, agents) => { root.save-host(id, config, skills, agents); }
                restore(id) => { root.focus-owner = "host"; root.restore-host(id); }
                visibility-changed(id, visible) => { root.host-visible(id, visible); }
            }
            if root.page > 0 && root.page < 8: ResourcePage {
                page: root.page; rows: root.rows; query <=> root.query;
                selected-id: root.selected-id; selected-name: root.selected-name;
                selected-description: root.selected-description; selected-meta: root.selected-meta;
                selected-content: root.selected-content; selected-models: root.selected-models;
                deployments: root.deployments; project-skills: root.project-skills; hosts: root.visible-hosts;
                action-one: root.action-one; action-two: root.action-two; action-three: root.action-three;
                interactive: root.interactive; writable: root.writable; list-scroll-y <=> root.list-scroll-y; detail-scroll-y <=> root.detail-scroll-y;
                detail-load-state: root.detail-load-state; detail-error: root.detail-error;
                markdown-blocks: root.markdown-blocks; markdown-source <=> root.markdown-source;
                focus-owner <=> root.focus-owner; focus-request: root.return-focus-request;
                search(value) => { root.search(value); }
                select-row(id) => { root.select-row(id); }
                select-relative(delta) => { root.select-relative(delta); }
                select-index(index) => { root.select-index(index); }
                action(kind) => { root.action(kind); }
                toggle(host, enabled) => { root.toggle(host, enabled); }
                project-toggle(skill, host, enabled) => { root.project-toggle(skill, host, enabled); }
                project-reset(skill, host) => { root.project-reset(skill, host); }
                copy-text(value) => { root.copy-text(value); }
                copy-code(value) => { root.copy-code(value); }
                copy-uri(value) => { root.copy-uri(value); }
                retry-detail => { root.retry-detail(); }
            }
        }
    }
    if root.dialog-open: Rectangle {
        background: Theme.foreground.with-alpha(0.28);
        TouchArea { }
        Editor {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(root.dialog-mcp || root.dialog-importer ? 780px : 660px, parent.width - 64px);
            height: min(parent.height - 56px, root.dialog-short || root.dialog-confirmation ? self.preferred-height : parent.height - 56px);
            title: root.dialog-title; description: root.dialog-description; error: root.dialog-error;
            busy: root.busy || root.dialog-busy; can-submit: root.dialog-can-submit; can-cancel: root.dialog-can-cancel;
            load-state: root.dialog-load-state; short: root.dialog-short; discard-open: root.dialog-discard-open;
            installer: root.dialog-installer; importer: root.dialog-importer; confirmation: root.dialog-confirmation; mcp: root.dialog-mcp;
            import-count: root.import-count; has-apply-targets: root.has-apply-targets;
            fields <=> root.fields; candidates <=> root.candidates; import-rows <=> root.import-rows; apply-hosts <=> root.apply-hosts;
            import-query <=> root.import-query; import-host-filter <=> root.import-host-filter;
            import-host-names: root.import-host-names; import-conflict: root.import-conflict; import-compatibility: root.import-compatibility;
            mcp-type <=> root.mcp-type; mcp-command <=> root.mcp-command; mcp-endpoint <=> root.mcp-endpoint;
            mcp-args <=> root.mcp-args; mcp-args-action <=> root.mcp-args-action; mcp-args-stored-count: root.mcp-args-stored-count;
            mcp-env <=> root.mcp-env; mcp-headers <=> root.mcp-headers;
            mcp-secret-action <=> root.mcp-secret-action; mcp-secret-stored: root.mcp-secret-stored; mcp-secret <=> root.mcp-secret;
            mcp-advanced <=> root.mcp-advanced; mcp-show-advanced <=> root.mcp-show-advanced;
            cancel => { root.close-dialog(); }
            submit => { root.submit-dialog(); }
            preview => { root.preview-skills(); }
            retry => { root.retry-dialog(); }
            discard => { root.discard-dialog(); }
            continue-editing => { root.continue-dialog(); }
            dialog-changed => { root.dialog-changed(); }
            field-changed(key) => { root.field-changed(key); }
            import-selection-changed => { root.import-selection-changed(); }
            import-filter-changed(value, host) => { root.import-filter-changed(value, host); }
            mcp-type-changed(value) => { root.mcp-type-changed(value); }
            mcp-arg-add => { root.mcp-arg-add(); }
            mcp-arg-remove(index) => { root.mcp-arg-remove(index); }
            mcp-entry-add(kind) => { root.mcp-entry-add(kind); }
            mcp-entry-remove(kind, index) => { root.mcp-entry-remove(kind, index); }
            mcp-entry-changed(kind, index) => { root.mcp-entry-changed(kind, index); }
        }
    }
}
