import { Theme } from "theme.slint";
export component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 76px;
    min-height: 36px;
    max-height: self.min-height;
    preferred-width: max(76px, label.preferred-width + 28px);
    preferred-height: 36px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-width: 2px;
    border-color: focus.has-focus ? Theme.ring : Theme.border;
    border-radius: 6px;
    background: root.danger ? Theme.error-surface : root.primary ? (touch.has-hover ? Theme.primary-hover : Theme.primary) : (touch.has-hover ? Theme.muted : Theme.card);
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    label := Text { text: root.text; color: root.danger ? Theme.destructive : Theme.foreground; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        // Keyboard target only: a full-size sibling would cover TouchArea and
        // consume the first pointer press to acquire focus instead of clicking.
        x: 0px; y: 0px; width: 0px; height: 0px;
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } return reject; }
    }
}
export component Card inherits Rectangle {
    background: Theme.card;
    border-width: 2px; border-color: Theme.border; border-radius: 10px;
    @children
}
export component MutedText inherits Text { color: Theme.muted-foreground; font-size: 12px; wrap: word-wrap; }
export component Heading inherits Text { overflow: elide; wrap: no-wrap; color: Theme.foreground; font-size: 20px; font-weight: 700; }
export struct ResourceRow { id: string, name: string, description: string, meta: string }
export struct HostToggle { id: string, name: string, enabled: bool, available: bool, status: string, reset: bool }
export struct HostRow { id: string, name: string, status: string, installed: bool, visible: bool, config: string, skills: string, agents: string }
export struct ProjectSkillRow { id: string, name: string, hosts: [HostToggle] }
export struct FormField { key: string, label: string, value: string, kind: int, placeholder: string }
export struct CandidateRow { name: string, description: string, path: string, checked: bool, installed: bool }

export struct ImportRow { id: string, name: string, description: string, source: string, checked: bool, available: bool, reason: string, remote: bool }
export struct ApplyHostRow { id: string, name: string, checked: bool, available: bool, reason: string }
